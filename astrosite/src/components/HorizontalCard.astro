---
const {
  title,
  img,
  desc,
  url,
  badge,
  tags,
  target = "_blank",
  titleTag = "h3",
  company,
  type,
  highlights,
} = Astro.props;
import { Image } from "astro:assets";

const TitleTag = titleTag;

// Company label for work, "Personal Project" otherwise (blog cards pass neither)
const companyLabel = company || (type === "personal" ? "Personal Project" : null);
const hasHighlights = highlights && highlights.length > 0;

// Only compute tag_url if url exists
const tag_url = url ? url.split("/").slice(0, -1).join("/") + "/tag" : null;
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  {
    url ? (
      <a href={url} target={target}>
        <div class="hero-content flex-row md:flex-row">
          {img && (
            <Image
              src={`${import.meta.env.BASE_URL}${img}`}
              width={750}
              height={422}
              format="webp"
              alt={title}
              class="max-w-[13rem] rounded-lg"
            />
          )}
          <div class="grow w-full">
            <TitleTag class="text-xl font-bold">
              {title}
              {badge && <span class="badge badge-secondary mx-2">{badge}</span>}
            </TitleTag>
            {companyLabel && (
              <div class="mt-1">
                <span class="badge badge-outline badge-sm">{companyLabel}</span>
              </div>
            )}
            {hasHighlights ? (
              <ul class="py-1 mt-1 list-disc ml-5 space-y-1">
                {highlights.map((h) => (
                  <li set:html={h} />
                ))}
              </ul>
            ) : (
              <p class="py-1 text-1xl">{desc}</p>
            )}

            <div class="card-actions justify-end">
              {tags &&
                tag_url &&
                tags.map((tag) => (
                  <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                    {tag}
                  </a>
                ))}
            </div>
          </div>
        </div>
      </a>
    ) : (
      <div class="hero-content flex-col md:flex-row">
        {img && (
          <Image
            src={`${import.meta.env.BASE_URL}${img}`}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )}
        <div class="grow w-full">
          <TitleTag class="text-xl font-bold">
            {title}
            {badge && <span class="badge badge-secondary mx-2">{badge}</span>}
          </TitleTag>
          {companyLabel && (
            <div class="mt-1">
              <span class="badge badge-outline badge-sm">{companyLabel}</span>
            </div>
          )}
          {hasHighlights ? (
            <ul class="py-1 mt-1 list-disc ml-5 space-y-1">
              {highlights.map((h) => (
                <li set:html={h} />
              ))}
            </ul>
          ) : (
            <p class="py-1 text-1xl">{desc}</p>
          )}
          <div class="card-actions justify-end">
            {tags &&
              tags.map((tag) => <span class="badge badge-outline">{tag}</span>)}
          </div>
        </div>
      </div>
    )
  }
</div>
