---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";

// Only compute tag_url if url exists
const tag_url = url ? url.split("/").slice(0, -1).join("/") + "/tag" : null;
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  {
    url ? (
      <a href={url} target={target}>
        <div class="hero-content flex-col md:flex-row">
          {img && (
            <Image
              src={`${import.meta.env.BASE_URL}${img}`}
              width={750}
              height={422}
              format="webp"
              alt={title}
              class="max-w-full md:max-w-[13rem] rounded-lg"
            />
          )}
          <div class="grow w-full">
            <h1 class="text-xl font-bold">
              {title}
              {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
            </h1>
            <p class="py-1 text-1xl">{desc}</p>
            <div class="card-actions justify-end">
              {tags &&
                tag_url &&
                tags.map((tag) => (
                  <a href={`${tag_url}/${tag}`} class="badge badge-outline">
                    {tag}
                  </a>
                ))}
            </div>
          </div>
        </div>
      </a>
    ) : (
      <div class="hero-content flex-col md:flex-row">
        {img && (
          <Image
            src={`${import.meta.env.BASE_URL}${img}`}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )}
        <div class="grow w-full">
          <h1 class="text-xl font-bold">
            {title}
            {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
          </h1>
          <p class="py-1 text-1xl">{desc}</p>
          <div class="card-actions justify-end">
            {tags &&
              tags.map((tag) => <span class="badge badge-outline">{tag}</span>)}
          </div>
        </div>
      </div>
    )
  }
</div>
