---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import { getEntryBySlug } from "astro:content";
import createSlug from "../lib/createSlug";

const about = await getEntryBySlug("about", "about");
const projects = await getCollection("projects");
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// filter pinned projects
const pinnedProjects = projects
  .filter((p) => p.data.pin)
  .sort((a, b) => b.data.priority - a.data.priority);

const { Content: AboutMe } = await about.render();
const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <section class="prose max-w-6xl p-6">
    <AboutMe />
  </section>
  <!-- renders the MDX -->
  <section>
    <div>
      <div class="text-2xl w-full font-bold mb-5 mt-10">
        Projects I've Worked On
      </div>
    </div>
    {
      pinnedProjects.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            target="_self"
            url={`${import.meta.env.BASE_URL}projects/${createSlug(post.data.title, post.slug)}`}
          />
          <div class="divider my-0" />
        </>
      ))
    }
    <div class="mt-8">
      <a href={`${import.meta.env.BASE_URL}projects/`}>
        <button class="btn btn-block btn-info">See More</button>
      </a>
    </div>
  </section>

  <section>
    <div>
      <div class="text-2xl w-full font-bold mb-5 mt-10">Latest from blog</div>
    </div>
    {
      last_posts.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={`${import.meta.env.BASE_URL}blog/${createSlug(post.data.title, post.slug)}`}
            target="_self"
            badge={post.data.badge}
          />
          <div class="divider my-0" />
        </>
      ))
    }
    <div class="mt-8">
      <a href={`${import.meta.env.BASE_URL}blog/`}>
        <button class="btn btn-block btn-wide btn-info">See More</button></a
      >
    </div>
  </section>

  <section class="block">
    <div>
      <div class="text-2xl w-full font-bold mb-5 mt-10">Contact</div>
    </div>
    <section class="grid grid-cols-1 md:grid-cols-2 gap-2 max-w-5xl mx-auto">
      <div class="card card-border bg-base-100 card-sm w-96 shadow-sm">
        <div class="card-body">
          <h3 class="card-title">Address</h3>
          <p>Baner, Pune,<br /> Maharashtra 411045</p>
        </div>
      </div>

      <div class="card card-border bg-base-100 card-sm w-96 shadow-sm">
        <div class="card-body">
          <h3 class="card-title">Phone</h3>
          <p>(+91) 7624853821</p>
        </div>
      </div>

      <div class="card card-border bg-base-100 card-sm w-96 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">Email</h2>
          <a>raopavank@gmail.com</a>
        </div>
      </div>

      <div class="card card-border bg-base-100 card-sm w-96 shadow-sm">
        <div class="card-body">
          <h3 class="card-title">Socials</h3>
          <p>
            A card component has a figure, a body part, and inside body there
            are title and actions parts
          </p>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>
