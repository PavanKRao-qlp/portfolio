---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getEntryBySlug } from "astro:content";
import createSlug from "../lib/createSlug";

const about = await getEntryBySlug("about", "about");
const projects = await getCollection("projects");
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// filter pinned projects
const pinnedProjects = projects
  .filter((p) => p.data.pin)
  .sort((a, b) => b.data.priority - a.data.priority);

const { Content: AboutMe } = await about.render();
const pinnedPosts = posts.filter((p) => p.data.pinned);
const regularPosts = posts.filter((p) => !p.data.pinned);
const last_posts = [...pinnedPosts, ...regularPosts].slice(0, 5);

const resumeUrl = `${import.meta.env.BASE_URL}PavanKumarRao_SeniorGameplayProgrammer.pdf`;
const linkedinUrl = "https://www.linkedin.com/in/pavan-kumar-rao-82949b119/";
const githubUrl = "https://github.com/PavanKRao-qlp";
const email = "raopavank@gmail.com";

const skills = [
  "C++",
  "Unreal Engine",
  "Unity",
  "Multiplayer",
  "ECS",
  "Gameplay Systems",
];
---

<BaseLayout sideBarActiveItemID="home">
  <!-- Hero -->
  <section class="max-w-6xl">
    <div
      class="flex flex-col-reverse gap-8 md:flex-row md:items-center md:justify-between"
    >
      <div class="flex-1">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight">
          Pavan Kumar Rao
        </h1>
        <p class="mt-3 text-xl md:text-2xl opacity-90">
          Senior Gameplay Programmer — Unreal Engine &amp; Unity
        </p>
        <p class="mt-2 opacity-70">
          Pune, India · 8 years building real-time gameplay, multiplayer, and
          engine systems in C++
        </p>

        <div class="mt-4">
          <span class="badge badge-success badge-outline"
            >Open to gameplay &amp; engine roles</span
          >
        </div>

        <div class="mt-3 flex flex-wrap gap-2">
          {skills.map((s) => <span class="badge badge-outline">{s}</span>)}
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <a href={resumeUrl} download>
            <button class="btn btn-info">Download Resume</button>
          </a>
          <a href={`mailto:${email}`}>
            <button class="btn btn-outline">Email</button>
          </a>
          <a href={linkedinUrl} target="_blank" rel="noopener">
            <button class="btn btn-outline">LinkedIn</button>
          </a>
          <a href={githubUrl} target="_blank" rel="noopener">
            <button class="btn btn-outline">GitHub</button>
          </a>
        </div>
      </div>

      <!-- Profile photo hidden for now; uncomment to restore.
      <div class="shrink-0 self-center">
        <Image
          src={`${import.meta.env.BASE_URL}me.png`}
          width={400}
          height={400}
          format="webp"
          alt="Portrait of Pavan Kumar Rao"
          class="mask mask-hexagon w-44 md:w-56"
        />
      </div>
      -->
    </div>
  </section>

  <!-- About -->
  <section class="prose max-w-6xl mt-12">
    <h2>About</h2>
    <AboutMe />
  </section>

  <!-- Featured Work -->
  <section>
    <h2 class="text-2xl w-full font-bold mb-5 mt-12">Featured Work</h2>
    {
      pinnedProjects.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            company={post.data.company}
            type={post.data.type}
            highlights={post.data.highlights}
            target="_self"
            url={`${import.meta.env.BASE_URL}projects/${createSlug(post.data.title, post.slug)}`}
          />
          <div class="divider my-0" />
        </>
      ))
    }
    <div class="mt-8">
      <a href={`${import.meta.env.BASE_URL}projects/`}>
        <button class="btn btn-block btn-info">See More</button>
      </a>
    </div>
  </section>

  <!-- Blog -->
  <section>
    <h2 class="text-2xl w-full font-bold mb-5 mt-12">Latest from blog</h2>
    {
      last_posts.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={`${import.meta.env.BASE_URL}blog/${createSlug(post.data.title, post.slug)}`}
            target="_self"
            badge={post.data.badge}
            tags={post.data.tags}
          />
          <div class="divider my-0" />
        </>
      ))
    }
    <div class="mt-8">
      <a href={`${import.meta.env.BASE_URL}blog/`}>
        <button class="btn btn-block btn-wide btn-info">See More</button></a
      >
    </div>
  </section>

  <!-- Contact -->
  <section class="block">
    <h2 class="text-2xl w-full font-bold mb-5 mt-12">Contact</h2>
    <section class="grid grid-cols-1 md:grid-cols-2 gap-2 max-w-5xl">
      <div class="card card-border bg-base-100 card-sm w-full shadow-sm">
        <div class="card-body">
          <h3 class="card-title">Email</h3>
          <a href={`mailto:${email}`}>{email}</a>
        </div>
      </div>

      <div class="card card-border bg-base-100 card-sm w-full shadow-sm">
        <div class="card-body">
          <h3 class="card-title">Socials</h3>
          <div>
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener"
              class="mx-3"
              aria-label="Github"
              title="Github"
            >
              <div class="flex flex-row space-x-1 ...">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  style="fill: currentColor;transform: ;msFilter:;"
                  ><path
                    fill-rule="evenodd"
                    clip-rule="evenodd"
                    d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"
                  ></path>
                </svg>
                <div>Github</div>
              </div>
            </a>
            <a
              href={linkedinUrl}
              target="_blank"
              rel="noopener"
              class="mx-3"
              aria-label="Linkedin"
              title="Linkedin"
            >
              <div class="flex flex-row space-x-1 ...">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  style="fill: currentColor;transform: ;msFilter:;"
                  ><circle cx="4.983" cy="5.009" r="2.188"></circle><path
                    d="M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118 1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095z"
                  ></path>
                </svg>
                <div>LinkedIn</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>
