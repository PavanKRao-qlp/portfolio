---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
const projects = await getCollection("projects");

const workProjects = projects
  .filter((p) => p.data.type == "work")
  .sort((a, b) => b.data.priority - a.data.priority);
const personalProjects = projects
  .filter((p) => p.data.type != "work")
  .sort((a, b) => b.data.priority - a.data.priority);
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <section>
    <div>
      <div class="text-3xl w-full font-bold mb-5 mt-10">Professional Works</div>
    </div>
    {
      workProjects.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={`${import.meta.env.BASE_URL}projects/${createSlug(post.data.title, post.slug)}`}
            target="_self"
          />
          <div class="divider my-0" />
        </>
      ))
    }
  </section>
  <section>
    <div>
      <div class="text-3xl w-full font-bold mb-5 mt-10">Personal Works</div>
    </div>
    {
      personalProjects.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={`${import.meta.env.BASE_URL}projects/${createSlug(post.data.title, post.slug)}`}
            target="_self"
          />
          <div class="divider my-0" />
        </>
      ))
    }
  </section>
</BaseLayout>
