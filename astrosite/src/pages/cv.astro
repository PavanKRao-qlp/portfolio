---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="CV" includeSidebar={true} sideBarActiveItemID="cv">
  <div class="flex flex-col w-full h-screen p-0 m-0">
    <!-- Top bar with Download button -->
    <div>
      <a href={`${import.meta.env.BASE_URL}PavanKumarRao.pdf`}>
        <button class="btn btn-block btn-info">Download Resume</button>
      </a>
    </div>

    <!-- PDF Embed -->
    <div class="flex-1">
      <embed
        src={`${import.meta.env.BASE_URL}PavanKumarRao.pdf`}
        type="application/pdf"
        class="w-full h-full"
      />
    </div>
  </div>
</BaseLayout>
